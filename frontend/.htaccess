<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Permitir archivos y directorios existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirigir todo a index.html para SPA (Single Page Application)
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# Permitir CORS desde localhost
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "http://localhost"
    Header set Access-Control-Allow-Origin "http://localhost:8000"
    Header set Access-Control-Allow-Origin "http://127.0.0.1"
</IfModule>
